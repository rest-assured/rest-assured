<!--
  ~ json-path-gpath is the name json-path gets in REST Assured 7.0.0. In 6.x this pom only relocates to json-path at the same version,
  ~ so that you can switch to the new name before upgrading. In 7.0.0 the jar moves here and json-path relocates to json-path-gpath.
  -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.rest-assured</groupId>
        <artifactId>rest-assured-parent</artifactId>
        <version>6.3.0</version>
    </parent>
    <groupId>io.rest-assured</groupId>
    <artifactId>json-path-gpath</artifactId>
    <packaging>pom</packaging>
    <version>6.3.0</version>
    <name>json-path-gpath</name>
    <description>The REST Assured 7.0.0 name of json-path. In 6.x it relocates to json-path.</description>
    <url>https://rest-assured.io/</url>

    <distributionManagement>
        <relocation>
            <groupId>io.rest-assured</groupId>
            <artifactId>json-path</artifactId>
            <message>json-path-gpath is the REST Assured 7.0.0 name of json-path. In REST Assured 6.x it resolves to json-path, so nothing changes until you upgrade.</message>
        </relocation>
    </distributionManagement>
</project>
