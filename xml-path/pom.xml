<!--
  ~ xml-path is called xml-path-gpath since REST Assured 7.0.0. This pom only relocates to xml-path-gpath at the same
  ~ version, so that builds that still use the old name keep working. It's removed in REST Assured 8.0.0.
  -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.rest-assured</groupId>
        <artifactId>rest-assured-parent</artifactId>
        <version>7.0.0-SNAPSHOT</version>
    </parent>
    <groupId>io.rest-assured</groupId>
    <artifactId>xml-path</artifactId>
    <packaging>pom</packaging>
    <version>7.0.0-SNAPSHOT</version>
    <name>xml-path</name>
    <description>The name of xml-path-gpath before REST Assured 7.0.0. It relocates to xml-path-gpath and is removed in 8.0.0.</description>
    <url>https://rest-assured.io/</url>

    <distributionManagement>
        <relocation>
            <groupId>io.rest-assured</groupId>
            <artifactId>xml-path-gpath</artifactId>
            <message>xml-path is called xml-path-gpath since REST Assured 7.0.0. Use io.rest-assured:xml-path-gpath instead, since xml-path is removed in REST Assured 8.0.0.</message>
        </relocation>
    </distributionManagement>
</project>
