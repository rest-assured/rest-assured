<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.rest-assured</groupId>
        <artifactId>modules</artifactId>
        <version>7.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>json-path-jayway</artifactId>
    <packaging>bundle</packaging>
    <version>7.0.0-SNAPSHOT</version>
    <name>json-path-jayway</name>
    <description>The Jayway JsonPath engine for JSON paths in REST Assured, such as $.store.book[?(@.price &lt; 10)].title. It doesn't depend on Groovy.</description>
    <url>https://rest-assured.io/</url>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <!-- The version file in META-INF/rest-assured, which REST Assured reads to check that its artifacts have the same version -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/main/rest-assured-version</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <!-- Checks that this module doesn't bring Groovy (see the root pom) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Export-Package>
                            io.restassured.path.jayway.*,
                            io.restassured.internal.path.jayway.*
                        </Export-Package>
                        <!-- Jayway JsonPath 2.8.0 and later, including 3.x -->
                        <Import-Package>
                            com.jayway.jsonpath.*;version="[2.8,4)",
                            *
                        </Import-Package>
                    </instructions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.basepom.maven</groupId>
                <artifactId>duplicate-finder-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured-common</artifactId>
            <version>7.0.0-SNAPSHOT</version>
        </dependency>
        <!-- Brings json-smart, which Jayway's filter compiler uses for literals such as [?(@.tag in ['a','b'])]. Bodies are
             parsed by this module's own parser, so that numbers follow JsonConfig -->
        <dependency>
            <groupId>com.jayway.jsonpath</groupId>
            <artifactId>json-path</artifactId>
        </dependency>

        <!-- Test. rest-assured's GPath dependencies are optional, so only Jayway evaluates paths in this module's tests -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>7.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
